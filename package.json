{
  "name": "@munitoai/openclaw-provider",
  "version": "0.1.0",
  "description": "Munito AI in OpenClaw: open models for Europe, private by default",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "munito",
    "llm",
    "provider",
    "eu"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://docs.munito.ai/openclaw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munitoai/openclaw-provider.git"
  },
  "files": [
    "src",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "prepack": "node scripts/build.mjs --check"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.7"
  },
  "openclaw": {
    "extensions": [
      "./src/index.js"
    ],
    "install": {
      "npmSpec": "@munitoai/openclaw-provider",
      "clawhubSpec": "clawhub:@munitoai/openclaw-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.10.7"
    },
    "compat": {
      "pluginApi": ">=2026.10.7"
    },
    "build": {
      "openclawVersion": "2026.10.7"
    }
  }
}
